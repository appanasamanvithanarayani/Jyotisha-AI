{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jyotisha-ai.local/schemas/knowledge-inventory-1.0.0.json",
  "title": "Jyotisha AI knowledge inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["inventory_version", "areas"],
  "properties": {
    "inventory_version": {"const": "1.0.0"},
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area_id", "title", "taxonomy_categories", "knowledge_kinds", "scope", "evidence_needed", "review_requirements", "status", "linked_knowledge_ids"],
        "properties": {
          "area_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "title": {"type": "string", "minLength": 1},
          "taxonomy_categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "knowledge_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["astronomical_calculation", "classical_textual_statement", "traditional_interpretation", "modern_explanation", "project_workflow_note"]}},
          "scope": {"type": "string", "minLength": 1},
          "evidence_needed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "review_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["not_researched", "sources_identified", "evidence_collected", "drafted", "needs_review", "reviewed", "blocked"]},
          "linked_knowledge_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  }
}
