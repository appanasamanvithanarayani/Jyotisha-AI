{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jyotisha-ai.local/schemas/knowledge-record-1.0.0.json",
  "title": "Jyotisha AI knowledge record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_version", "knowledge_id", "concept", "concept_category", "tradition", "evidence_type", "review_status", "source_references"],
  "properties": {
    "record_version": {"const": "1.0.0"},
    "knowledge_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "concept": {"type": "string", "minLength": 1},
    "concept_category": {"type": "string"},
    "tradition": {"type": "string"},
    "tradition_name": {"type": ["string", "null"]},
    "canonical_term": {"type": ["string", "null"]},
    "sanskrit_devanagari": {"type": ["string", "null"]},
    "sanskrit_transliteration": {"type": ["string", "null"]},
    "english_explanation": {"type": ["string", "null"]},
    "telugu_explanation": {"type": ["string", "null"]},
    "rule_statement": {"type": ["string", "null"]},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "exceptions": {"type": "array", "items": {"type": "string"}},
    "examples": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["text", "kind"], "properties": {"text": {"type": "string", "minLength": 1}, "kind": {"enum": ["reviewer_illustration", "source_example"]}, "source_reference_index": {"type": ["integer", "null"], "minimum": 0}}}},
    "source_references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_id"], "properties": {"source_id": {"type": "string"}, "edition": {"type": ["string", "null"]}, "chapter": {"type": ["string", "null"]}, "page": {"type": ["string", "null"]}, "verse": {"type": ["string", "null"]}, "passage_id": {"type": ["string", "null"]}, "locator_note": {"type": ["string", "null"]}}}},
    "evidence_type": {"enum": ["taxonomy_placeholder", "original_text", "translation", "commentary", "reviewer_explanation", "model_hypothesis"]},
    "review_status": {"enum": ["needs_review", "reviewed", "disputed", "rejected"]},
    "reviewer_id": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date"},
    "review_notes": {"type": ["string", "null"]},
    "conflicts_with": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
