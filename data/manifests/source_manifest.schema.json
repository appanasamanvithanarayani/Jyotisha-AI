{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jyotisha-ai.local/schemas/source-manifest-1.1.0.json",
  "title": "Jyotisha AI source manifest record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "title",
    "source_type",
    "languages",
    "original_language",
    "file_format",
    "provenance",
    "permission",
    "processing"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "authors": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
    "source_type": {
      "enum": ["classical_text", "translation", "commentary", "textbook", "article", "other"]
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "original_language": { "type": "string", "minLength": 2 },
    "file_format": { "enum": ["txt", "pdf"] },
    "edition": { "type": ["string", "null"] },
    "publication_year": { "type": ["integer", "null"], "minimum": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acquired_from", "acquired_at"],
      "properties": {
        "acquired_from": { "type": "string", "minLength": 1 },
        "acquired_at": { "type": ["string", "null"], "format": "date" },
        "canonical_url": { "type": ["string", "null"], "format": "uri" },
        "local_path": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "allowed_uses", "reviewed_at"],
      "properties": {
        "status": { "enum": ["approved", "public_domain", "restricted", "pending_review", "rejected"] },
        "license": { "type": ["string", "null"] },
        "rights_holder": { "type": ["string", "null"] },
        "allowed_uses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["catalog", "ocr", "research", "training", "redistribution"] }
        },
        "jurisdiction": { "type": ["string", "null"] },
        "evidence_reference": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"], "format": "date" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors", "review_notes"],
      "properties": {
        "status": { "enum": ["cataloged", "blocked", "ready", "processing", "processed", "failed"] },
        "errors": { "type": "array", "items": { "type": "string" } },
        "review_notes": { "type": ["string", "null"] },
        "last_run_id": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
