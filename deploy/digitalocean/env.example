# Copy to .env on the server and fill in. Never commit the real .env.
DOMAIN=jyotisha.example.com
CONTACT_EMAIL=support@example.com
ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ASK_DAILY_LIMIT=1000
# Leave empty until Google AdSense approves your own domain; then ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_CLIENT=
# Ads in the Android app (AdMob). 1 = show a banner, 0 = hide. With no banner id Google test ads are shown.
APP_ADS=0
ADMOB_BANNER_ID=
ADMOB_TESTING=0
