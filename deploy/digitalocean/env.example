# Copy to .env on the server and fill in. Never commit the real .env.
DOMAIN=jyotisha.example.com
CONTACT_EMAIL=support@example.com
ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ASK_DAILY_LIMIT=1000
# Leave empty until Google AdSense approves your own domain; then ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_CLIENT=
# Ads in the Android app (AdMob). 1 = show a banner, 0 = hide. With no banner id Google test ads are shown.
APP_ADS=0
ADMOB_BANNER_ID=
ADMOB_TESTING=0
# Watch-an-ad-to-generate-a-Kundli, and an occasional ad between screens (need APP_ADS=1; test ads until you add your own unit ids)
REWARDED_KUNDLI=0
ADMOB_REWARDED_ID=
INTERSTITIAL=0
ADMOB_INTERSTITIAL_ID=
# AI chat: this many free AI questions a day, then a rewarded ad gives a few more (needs APP_ADS=1)
REWARDED_CHAT=0
CHAT_FREE_QUESTIONS=10
CHAT_BONUS_QUESTIONS=5
