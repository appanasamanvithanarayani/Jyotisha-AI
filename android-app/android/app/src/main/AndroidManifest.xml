<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".JyotishaApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- The SDK's ContentProvider initializes before Application.onCreate(), which is too early
             for BuildConfig-backed credentials. Remove it and initialize explicitly in
             JyotishaApplication only when both values are configured. -->
        <provider
            android:name="com.facebook.internal.FacebookInitProvider"
            android:authorities="${applicationId}.FacebookInitProvider"
            tools:node="remove" />

        <!-- App installs and launches are logged automatically after JyotishaApplication initializes
             Meta App Events. Extra screen-content/product-improvement collection stays off. -->
        <meta-data android:name="com.facebook.sdk.AutoInitEnabled" android:value="false" />
        <meta-data android:name="com.facebook.sdk.AutoLogAppEventsEnabled" android:value="true" />
        <meta-data android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled" android:value="true" />
        <meta-data android:name="com.facebook.sdk.AutoLogMetaDataEnabled" android:value="false" />
        <meta-data android:name="com.facebook.sdk.AutoLogProductImprovementEnabled" android:value="false" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
            <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="ca-app-pub-3940256099942544~3347511713" />
        <!-- Messages sent from the admin panel (Firebase) use the app's notification icon and colour. -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_jyotisha" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_accent" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Without this, Android 12+ silently downgrades every scheduled reminder notification to an inexact alarm,
         which Doze/App Standby can delay for hours until the app is opened again. Auto-granted on Android 12;
         on Android 13+ the user can also turn it on themselves under Settings -> Apps -> Jyotirmaya -> Alarms & reminders. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- The palm scan opens the camera inside the app (a hand outline to line the palm up with). The photo is never stored. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Fallback: the palm reading can also open the phone's own camera app directly. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
