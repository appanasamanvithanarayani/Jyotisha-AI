<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 8.1+: dark navigation-bar icons on the light theme too. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/system_bars</item>
        <item name="android:statusBarColor">@color/system_bars</item>
        <item name="android:navigationBarColor">@color/system_bars</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>
</resources>
